# Copie para .env e preencha. O .env não vai para o Git.
# O settings.py carrega este arquivo com python-dotenv.

# Para gerar um valor:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Banco PostgreSQL criado por banco/01_criar_banco.sql.
# As migrações rodam com o dono do banco (caminhabilidade_owner).
DB_NAME=caminhabilidade
DB_USER=caminhabilidade_owner
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
